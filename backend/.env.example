# SQLite database path. Relative paths resolve from the backend directory.
VISTAAR_AUTH_DB=vistaar_auth.sqlite3

# Local development uses HTTP. Set these for your deployment.
VISTAAR_ENV=development
# Set true in production (required when SameSite=None).
VISTAAR_COOKIE_SECURE=false
VISTAAR_COOKIE_SAMESITE=lax
# For a separate frontend/API origin, list exact frontend origins, comma-separated.
# Local Vite origins on ports 5173 are allowed automatically outside production.
VISTAAR_CORS_ORIGINS=
VISTAAR_FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=

# OCR for scanned and handwritten PDFs.
VISTAAR_OCR_VISION_ENABLED=true
# Optional model override; defaults to the existing Gemini model fallback list.
VISTAAR_OCR_VISION_MODEL=
VISTAAR_OCR_FALLBACK=tesseract
VISTAAR_GEMINI_TIMEOUT_SECONDS=45
VISTAAR_TESSERACT_CMD=
VISTAAR_TESSERACT_TIMEOUT_SECONDS=30

# Optional password reset email configuration. Without SMTP, recovery returns HTTP 503.
VISTAAR_SMTP_HOST=
VISTAAR_SMTP_PORT=587
VISTAAR_SMTP_USERNAME=
VISTAAR_SMTP_PASSWORD=
VISTAAR_SMTP_FROM=
